{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-current-file",
            "type": "shell",
            "command": "REL_DIR=$(cygpath -m '${relativeFileDirname}'); REL_DIR=${REL_DIR#src/}; FILE=$(cygpath -m '${file}'); OUT_DIR=bin/$REL_DIR; mkdir -p \"$OUT_DIR\" bin/_debug && g++ -std=c++20 -g -O0 -Wall \"$FILE\" -o \"$OUT_DIR/${fileBasenameNoExtension}.exe\" && cp \"$OUT_DIR/${fileBasenameNoExtension}.exe\" bin/_debug/debug.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "run-current-file",
            "type": "shell",
            "command": "runc '${file}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-current-file",
            "type": "shell",
            "command": "REL_DIR=$(cygpath -m '${relativeFileDirname}'); REL_DIR=${REL_DIR#src/}; FILE=$(cygpath -m '${file}'); OUT_DIR=bin/$REL_DIR; mkdir -p $OUT_DIR bin/_debug && rm -f bin/_debug/*.class && javac -encoding UTF-8 -g -d $OUT_DIR $FILE && cp $OUT_DIR/*.class bin/_debug/",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "run-current-file",
            "type": "shell",
            "command": "runj '${file}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
